rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /payroll_periods/{periodId} {
      allow read, write: if true;
    }

    match /app_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
